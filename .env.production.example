# Values for the shared-host `.env` on rimboai.com
# (copy into server .env — do not commit real secrets)

APP_NAME=RIMBOAI
APP_ENV=production
APP_DEBUG=false
FORCE_HTTPS=true

# With the root .htaccess rewrite (or document root = public/), use clean URLs:
APP_URL=https://rimboai.com
ASSET_URL=

# Optional cookie domain across www / apex
SESSION_DOMAIN=.rimboai.com

# Frontend: keep empty (relative URLs). Rebuild with this only if you ever host the SPA elsewhere.
VITE_APP_URL=

# Token economics / cash profit reporting
CREDITS_USD_PER_CREDIT=0.01
CREDITS_MARKUP=1.25
USD_DZD_RATE=250
PAYMENT_GATEWAY_FEE_PERCENT=0
PAYMENT_GATEWAY_FEE_FIXED_DZD=0

# fal pricing safety
FAL_PRICING_MAX_AGE_MINUTES=1440
FAL_PRICING_MIN_COVERAGE=1.0
FAL_PRICING_MAX_CHANGE_RATIO=4.0
FAL_ESTIMATE_VARIANCE_ALERT_PERCENT=15
